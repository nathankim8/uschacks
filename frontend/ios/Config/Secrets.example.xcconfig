// Copy to Secrets.xcconfig (git-ignored) and fill in. All values are optional:
// without them, the app asks for the tag topic during setup.
//
// xcconfig treats "//" as a comment, so write URLs as  http:/$()/host:port

CG_DEVELOPMENT_TEAM = ABCDE12345
// Free Personal Team only:
// CG_BUNDLE_ID = com.campusguard.app.abcde12345
// CG_ENTITLEMENTS = Config/PersonalTeam.entitlements
CG_NTFY_TOPIC = campusguard-xxxxxxxx
// CG_NTFY_SERVER = https:/$()/ntfy.sh
// CG_FINDMY_URL = https:/$()/campus-guard-gateway.<subdomain>.workers.dev
// CG_FINDMY_TOKEN = <app token from backend/cloud-gateway/.secrets.local>
