{
  "name": "campus-guard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test tests/handler.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration.test.mjs",
    "check": "deno check supabase/functions/campus-guard/index.ts && deno lint supabase/functions && deno fmt --check supabase/functions",
    "dev": "supabase functions serve campus-guard",
    "start": "supabase start",
    "stop": "supabase stop",
    "demo:setup": "node scripts/setup-demo.mjs",
    "demo": "node --env-file=.env.demo scripts/simulate-phone.mjs"
  },
  "devDependencies": { "deno": "2.9.6", "supabase": "3.1.0" }
}
