# List required environment variable NAMES here (no real values).

# Backend CLI/demo environment (keep real values in backend/.env).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Trusted setup/testing only. NEVER ship in the mobile app or simulator client.
SUPABASE_SECRET_KEY=
# Legacy local Supabase key aliases, supported during migration.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Edge secret: optional publishable-key override; local runtime supplies anon key.
CAMPUS_GUARD_PUBLISHABLE_KEY=
# Optional comma-separated browser origins; native apps need no CORS origin.
ALLOWED_ORIGINS=
# Generated demo client credentials; never commit these values.
REPORTER_ACCESS_TOKEN=
OWNER_ACCESS_TOKEN=
UNRELATED_ACCESS_TOKEN=
DEVICE_ID=
ADVERTISEMENT_ID=
# Optional explicit opt-in to running disposable fixtures against a remote TEST project.
ALLOW_REMOTE_TEST_PROJECT=
